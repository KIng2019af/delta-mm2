-- Function to convert a table to a readable string (limited depth)
local function tableToString(tbl, indent, depth)
    indent = indent or 0
    depth = depth or 0
    if depth > 5 then return "(...)" end
    local pad = string.rep("  ", indent)
    local result = {}
    for k, v in pairs(tbl) do
        local key = type(k) == "string" and k or "["..tostring(k).."]"
        if type(v) == "table" then
            table.insert(result, pad .. key .. " = {\n" .. tableToString(v, indent+2, depth+1) .. pad .. "}")
        elseif type(v) == "string" then
            table.insert(result, pad .. key .. " = '" .. v .. "'")
        else
            table.insert(result, pad .. key .. " = " .. tostring(v))
        end
    end
    return table.concat(result, ",\n")
end

