-- --- Helper: recursively describe a GUI object
local function describe(obj, indent, depth)
    indent = indent or 0
    depth = depth or 0
    if depth > 10 then return "..." end
    local pad = string.rep("  ", indent)
    local desc = ""
    if obj:IsA("ScreenGui") or obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("ImageLabel") then
        local pos = obj.AbsolutePosition
        local size = obj.AbsoluteSize
        local text = obj:IsA("TextLabel") and obj.Text or (obj:IsA("TextButton") and obj.Text or "")
        local name = obj.Name
        desc = pad .. obj.ClassName .. " : " .. name .. " (Size: " .. size.X .. "x" .. size.Y .. ", Visible: " .. tostring(obj.Visible) .. ")"
        if text ~= "" then desc = desc .. " Text: '" .. text .. "'" end
        -- Check if it's a button and has a FireServer method (we'll note it)
        if obj:IsA("TextButton") then
            desc = desc .. " [Button]"
        end
        desc = desc .. "\n"
    else
        desc = pad .. obj.ClassName .. " : " .. obj.Name .. "\n"
    end
    -- Recursively list children
    for _, child in pairs(obj:GetChildren()) do
        desc = desc .. describe(child, indent+2, depth+1)
    end
    return desc
end

-- --- Find the trade window using multiple strategies
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    -- Strategy 1: ScreenGui with "Trade" in name
    for _, obj in pairs(gui:GetChildren()) do
        if obj:IsA("ScreenGui") and obj.Name:lower():find("trade") then
            return obj
        end
    end
    -- Strategy 2: Any large Frame with Accept/Add buttons
    for _, frame in pairs(gui:GetDescendants()) do
        if frame:IsA("Frame") and frame.AbsoluteSize.X > 200 and frame.AbsoluteSize.Y > 200 and frame.Visible then
            local hasAccept, hasAdd = false, false
            for _, btn in pairs(frame:GetDescendants()) do
                if btn:IsA("TextButton") then
                    if btn.Name:lower():find("accept") or btn.Text:lower():find("accept") then hasAccept = true end
                    if btn.Name:lower():find("add") or btn.Text:lower():find("add") then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                return frame
            end
        end
    end
    -- Strategy 3: Any ScreenGui that is Enabled (could be trade)
    for _, obj in pairs(gui:GetChildren()) do
        if obj:IsA("ScreenGui") and obj.Enabled then
            return obj
        end
    end
    return nil
end

