local function getRemote(name)
    local remote = TradeFolder:FindFirstChild(name)
    if remote then
        print("[DEBUG] Found remote: " .. name)
        return remote
    else
        print("[WARN] Remote not found: " .. name)
        return nil
    end
end

local SendRequest = getRemote("SendRequest")
local AcceptRequest = getRemote("AcceptRequest")
local StartTrade = getRemote("StartTrade")
