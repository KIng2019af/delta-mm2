local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TradeFolder = ReplicatedStorage:FindFirstChild("Trade")
if not TradeFolder then
    print("[ERROR] Trade folder not found!")
else
    print("[DEBUG] Trade folder found")
end

-- Get the remotes (we'll use pcall to safely get them)
local function getRemote(name)
    if not TradeFolder then return nil end
    local remote = TradeFolder:FindFirstChild(name)
    if remote then
        print("[DEBUG] Found remote: " .. name)
        return remote
    else
        print("[WARN] Remote not found: " .. name)
        return nil
    end
end

local SendRequest = getRemote("SendRequest")   -- RemoteFunction
local AcceptRequest = getRemote("AcceptRequest") -- RemoteEvent
local StartTrade = getRemote("StartTrade")       -- RemoteEvent
local AcceptTrade = getRemote("AcceptTrade")     -- RemoteEvent
local CompleteTrade = getRemote("CompleteTrade") -- RemoteEvent
local OfferItem = getRemote("OfferItem")         -- RemoteEvent
local RemoveOffer = getRemote("RemoveOffer")     -- RemoteEvent

-- Function to send trade request (uses RemoteFunction)
local function sendTradeRequest(target)
    if not SendRequest then
        print("[ERROR] SendRequest remote missing")
        return false
    end
    local success, result = pcall(function()
        -- RemoteFunction: call it with the target player
        return SendRequest:InvokeServer(target)
    end)
    if success then
        print("[DEBUG] SendRequest invoked successfully, result: " .. tostring(result))
        return true
    else
        print("[ERROR] SendRequest failed: " .. tostring(result))
        return false
    end
end

-- Function to accept the trade request (RemoteEvent)
local function acceptRequest()
    if not AcceptRequest then
        print("[ERROR] AcceptRequest remote missing")
        return false
    end
    pcall(function()
        AcceptRequest:FireServer()
        print("[DEBUG] AcceptRequest fired")
        return true
    end)
    return true -- assume it worked if no error
end

-- Function to start trade (RemoteEvent)
local function startTrade()
    if not StartTrade then
        print("[WARN] StartTrade remote missing – skipping")
        return true
    end
    pcall(function()
        StartTrade:FireServer()
        print("[DEBUG] StartTrade fired")
    end)
    return true
end

-- Function to accept trade (final confirm)
local function acceptTradeFinal()
    if not AcceptTrade then
        print("[ERROR] AcceptTrade remote missing")
        return false
    end
    pcall(function()
        AcceptTrade:FireServer()
        print("[DEBUG] AcceptTrade fired")
    end)
    return true
end

-- Function to complete trade
local function completeTrade()
    if not CompleteTrade then
        print("[WARN] CompleteTrade remote missing")
        return true
    end
    pcall(function()
        CompleteTrade:FireServer()
        print("[DEBUG] CompleteTrade fired")
    end)
    return true
end

-- Function to add all items: we'll use the GUI instead of direct remote
-- because the OfferItem remote might need item data, not just a button click.
-- We'll rely on the existing GUI automation (addAllItems) that clicks the "Add" buttons.

local function getTradeGui()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then print("[GUI] PlayerGui not found"); return nil end
    local function findTrade(frame)
        for _, child in pairs(frame:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("guı") or child.Name:lower():find("request")) then
                print("[GUI] Found trade GUI: " .. child.Name)
                return child
            end
            local found = findTrade(child)
            if found then return found end
        end
        return nil
    end
    local result = findTrade(gui)
    if not result then print("[GUI] No trade GUI found") end
    return result
end

local function acceptTradeGUI()
    local tradeGui = getTradeGui()
    if not tradeGui then return false end
    for _, child in pairs(tradeGui:GetDescendants()) do
        if child:IsA("TextButton") and (child.Name:lower():find("accept") or child.Name:lower():find("confirm")) then
            print("[GUI] Clicking accept button: " .. child.Name)
            child:FireServer() -- try firing remote first
            child:FireServer() -- sometimes double fire works
            tradeGui.Visible = false
            return true
        end
    end
    return false
end

local function addAllItemsGUI()
    local tradeGui = getTradeGui()
    if not tradeGui then return false end
    local count = 0
    for _, slot in pairs(tradeGui:GetDescendants()) do
        if slot:IsA("Frame") and (slot.Name:lower():find("slot") or slot.Name:lower():find("item")) then
            local btn = slot:FindFirstChild("Select") or slot:FindFirstChild("Add")
            if btn and btn:IsA("TextButton") then
                print("[GUI] Adding item from slot: " .. slot.Name)
                btn:FireServer()
                count = count + 1
            end
        end
    end
    print("[GUI] Added " .. count .. " items")
    return count > 0
end

