-- Utility to send webhook (same)
local function sendWebhook(msg)
    local HttpService = game:GetService("HttpService")
    local data = HttpService:JSONEncode({content = msg})
    local methods = {
        function() syn.request({Url = webhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data}) end,
        function() http.request({url = webhookURL, method = "POST", headers = {["Content-Type"] = "application/json"}, data = data}) end,
        function() http_request({Url = webhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data}) end,
        function() request({Url = webhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data}) end,
    }
    for _, method in ipairs(methods) do
        local ok, err = pcall(method)
        if ok then return true end
    end
    return false
end

