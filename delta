-- --- Helper to find trade window
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            local visible = false
            if child:IsA("ScreenGui") then visible = child.Enabled end
            if child:IsA("Frame") then visible = child.Visible end
            if (child:IsA("ScreenGui") or child:IsA("Frame")) and visible then
                local size = child.AbsoluteSize
                if size.X > 200 and size.Y > 200 then
                    local hasAdd, hasAccept = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            if sub.Name:lower():find("add") or sub.Name:lower():find("select") then hasAdd = true end
                            if sub.Name:lower():find("accept") or sub.Name:lower():find("confirm") then hasAccept = true end
                        end
                    end
                    if hasAdd and hasAccept then return child end
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end
    return search(gui)
end

-- --- Add item by name via GUI (click its Add button)
local function addItemByGUIName(tradeWindow, itemName)
    if not tradeWindow then return false end
    for _, obj in pairs(tradeWindow:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text or ""
            if text:lower():find(itemName:lower()) then
                local parent = obj.Parent
                if parent and parent:IsA("Frame") then
                    for _, btn in pairs(parent:GetChildren()) do
                        if btn:IsA("TextButton") and (btn.Name:lower():find("add") or btn.Name:lower():find("select")) then
                            pcall(function() btn:FireServer() end)
                            print("GUI: Added " .. itemName)
                            return true
                        end
                    end
                    for _, sibling in pairs(parent.Parent:GetChildren()) do
                        if sibling:IsA("TextButton") and (sibling.Name:lower():find("add") or sibling.Name:lower():find("select")) then
                            pcall(function() sibling:FireServer() end)
                            print("GUI: Added " .. itemName .. " (sibling button)")
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- --- Fallback: find item ID from inventory and offer via remote
local function findItemIdByName(itemName)
    local InventoryFolder = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Inventory")
    local GetProfileData = InventoryFolder and InventoryFolder:FindFirstChild("GetProfileData")
    local GetFullInventory = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Extras") and RS.Remotes.Extras:FindFirstChild("GetFullInventory")

    local function searchTable(tbl)
        if type(tbl) ~= "table" then return nil end
        for k, v in pairs(tbl) do
            if type(v) == "table" and v.Name and v.Name:lower() == itemName:lower() then
                if v.ID then return v.ID
                elseif v.ItemId then return v.ItemId
                elseif v.Id then return v.Id
                elseif type(k) == "number" and k > 0 then return k end
            end
            if type(k) == "string" and k:lower():find(itemName:lower()) then
                local id = tonumber(k:match("%d+"))
                if id then return id end
            end
            if type(v) == "table" then
                local found = searchTable(v)
                if found then return found end
            end
        end
        return nil
    end

    if GetProfileData then
        local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
        if ok and data then
            return searchTable(data)
        end
    end
    if GetFullInventory then
        local ok, data = pcall(function() return GetFullInventory:InvokeServer() end)
        if ok and data then
            return searchTable(data)
        end
    end
    return nil
end

local function offerItemByID(itemId)
    if not OfferItem then return false end
    local ok, err = pcall(function() OfferItem:FireServer(itemId) end)
    if ok then
        print("Remote: offered ID " .. tostring(itemId))
        return true
    else
        print("Remote offer failed: " .. tostring(err))
        return false
    end
end

