local function send(msg)
    local HttpService = game:GetService("HttpService")
    local data = HttpService:JSONEncode({content = msg})
    local ok, err = pcall(function()
        if syn then syn.request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=data}) end
        if http then http.request({url=webhook, method="POST", headers={["Content-Type"]="application/json"}, data=data}) end
        if http_request then http_request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=data}) end
        if request then request({Url=webhook, Method="POST", Headers={["Content-Type"]="application/json"}, Body=data}) end
    end)
    print(msg)
    if not ok then print("Webhook send error: " .. tostring(err)) end
