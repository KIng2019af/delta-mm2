-- Function to recursively scan for remote objects
local function scan(parent, depth)
    depth = depth or 0
    for _, child in pairs(parent:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            print(string.rep("  ", depth) .. "Found: " .. child:GetFullName() .. " (" .. child.ClassName .. ")")
        end
        scan(child, depth + 1)
    end
end

